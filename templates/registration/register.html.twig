{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
<section>
    <div class="container px-4">
        <div class="row gx-4 justify-content-center">
            <div class="col-lg-5">
                <h1>Enregistrement</h1>

                {{ form_errors(registrationForm) }}

                {{ form_start(registrationForm) }}
                    {{ form_row(registrationForm.firstname, {label: '* Prénom'}) }}
                    {{ form_row(registrationForm.lastname, {label: '* Nom'}) }}
                    {{ form_row(registrationForm.username, {label: "Nom d'utilisateur"}) }}
                    {{ form_row(registrationForm.email, {label: '* Adresse email'}) }}
                    {{ form_row(registrationForm.roles, {label: 'Role(s)'}) }}
                    {{ form_row(registrationForm.plainPassword, {label: '* Mot de passe'}) }}

                    <button type="submit" class="btn btn-outline-primary">Enregister</button>
                {{ form_end(registrationForm) }}
            </div>
        </div>
    </div>
</section>
{% endblock %}
